# frontend/.env.local の見本です。値は入れずに、変数名だけを書いています。
# 使うときは frontend/.env.local にコピーして、値を入力してください。

# Express の URL（ローカルでは http://localhost:4000）
BACKEND_URL=

# backend/.env と同じ値（scripts/sync-internal-api-key.mjs で自動設定できます）
INTERNAL_API_KEY=

# Firebase Console → Authentication → Users の管理者ユーザーの UID
FIREBASE_ADMIN_UID=

# Firebase Console → プロジェクトの設定 → 全般 → マイアプリ（ウェブアプリ）の firebaseConfig
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK（サーバー側の認証）
# Firebase Console → プロジェクトの設定 → サービスアカウント → 新しい秘密鍵を生成
# ダウンロードした JSON の client_email と private_key を入れます。
# private_key は " で囲み、1行のまま（\n を含んだまま）貼り付けます。
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
